#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, r32f) uniform writeonly image2D u_NoiseTexture;

uniform int u_Width;
uniform int u_Height;
uniform float u_CellSize;
uniform float u_Jitter;
uniform int u_DistanceType;
uniform int u_NoiseType;
uniform int u_Seed;
uniform float u_OffsetX;
uniform float u_OffsetY;

// FBM 파라미터
uniform int u_Octaves;
uniform float u_Lacunarity;
uniform float u_Gain;
uniform int u_CloudMode;  // 0~7

// ============================================================================
// 해시 함수
// ============================================================================

vec2 hash2(vec2 p)
{
    p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
    return fract(sin(p) * 43758.5453123);
}

vec3 hash3(vec3 p)
{
    p = vec3(
        dot(p, vec3(127.1, 311.7, 74.7)),
        dot(p, vec3(269.5, 183.3, 246.1)),
        dot(p, vec3(113.5, 271.9, 124.6))
    );
    return fract(sin(p) * 43758.5453123);
}

// ============================================================================
// Perlin Noise (2D)
// ============================================================================

float perlinNoise(vec2 p)
{
    vec2 i = floor(p);
    vec2 f = fract(p);
    
    vec2 u = f * f * (3.0 - 2.0 * f);
    
    float a = dot(hash2(i + vec2(0.0, 0.0)) * 2.0 - 1.0, f - vec2(0.0, 0.0));
    float b = dot(hash2(i + vec2(1.0, 0.0)) * 2.0 - 1.0, f - vec2(1.0, 0.0));
    float c = dot(hash2(i + vec2(0.0, 1.0)) * 2.0 - 1.0, f - vec2(0.0, 1.0));
    float d = dot(hash2(i + vec2(1.0, 1.0)) * 2.0 - 1.0, f - vec2(1.0, 1.0));
    
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y) * 0.5 + 0.5;
}

// ============================================================================
// 거리 계산
// ============================================================================

float euclideanDistance(vec3 a, vec3 b)
{
    vec3 diff = a - b;
    return length(diff);
}

float manhattanDistance(vec3 a, vec3 b)
{
    vec3 diff = abs(a - b);
    return diff.x + diff.y + diff.z;
}

float chebyshevDistance(vec3 a, vec3 b)
{
    vec3 diff = abs(a - b);
    return max(max(diff.x, diff.y), diff.z);
}

float calculateDistance(vec3 a, vec3 b, int distanceType)
{
    if (distanceType == 1)
        return manhattanDistance(a, b);
    else if (distanceType == 2)
        return chebyshevDistance(a, b);
    else
        return euclideanDistance(a, b);
}

// ============================================================================
// Worley Noise (3D)
// ============================================================================

float worleyNoise(vec3 pos)
{
    vec3 cellPos = floor(pos);
    vec3 localPos = fract(pos);
    
    float minDist1 = 10000.0;
    float minDist2 = 10000.0;
    
    for (int z = -1; z <= 1; z++)
    {
        for (int y = -1; y <= 1; y++)
        {
            for (int x = -1; x <= 1; x++)
            {
                vec3 neighborCell = cellPos + vec3(x, y, z);
                vec3 randomPoint = hash3(neighborCell + vec3(u_Seed * 0.1));
                randomPoint = mix(vec3(0.5), randomPoint, u_Jitter);
                vec3 pointPos = vec3(x, y, z) + randomPoint;
                
                float dist = calculateDistance(localPos, pointPos, u_DistanceType);
                
                if (dist < minDist1)
                {
                    minDist2 = minDist1;
                    minDist1 = dist;
                }
                else if (dist < minDist2)
                {
                    minDist2 = dist;
                }
            }
        }
    }
    
    float result;
    if (u_NoiseType == 1)
        result = minDist2;
    else if (u_NoiseType == 2)
        result = minDist2 - minDist1;
    else
        result = minDist1;
    
    if (u_DistanceType == 0)
        result = clamp(result * 0.7, 0.0, 1.0);
    else if (u_DistanceType == 1)
        result = clamp(result * 0.5, 0.0, 1.0);
    else
        result = clamp(result, 0.0, 1.0);
    
    return result;
}

// ============================================================================
// Billowy Noise - 뭉게구름 (둥근 형태)
// ============================================================================

float billowyNoise(vec3 pos)
{
    float noise = worleyNoise(pos);
    return abs(noise * 2.0 - 1.0);
}

// ============================================================================
// Ridged Noise - 능선 노이즈 (날카로운 가장자리)
// ============================================================================

float ridgedNoise(vec3 pos)
{
    float noise = worleyNoise(pos);
    return 1.0 - abs(noise * 2.0 - 1.0);
}

// ============================================================================
// Worley FBM
// ============================================================================

float worleyFBM(vec3 pos)
{
    float value = 0.0;
    float amplitude = 1.0;
    float frequency = 1.0;
    float maxValue = 0.0;
    
    for (int i = 0; i < u_Octaves; i++)
    {
        value += worleyNoise(pos * frequency) * amplitude;
        maxValue += amplitude;
        
        amplitude *= u_Gain;
        frequency *= u_Lacunarity;
    }
    
    return value / maxValue;
}

// ============================================================================
// Billowy FBM
// ============================================================================

float billowyFBM(vec3 pos)
{
    float value = 0.0;
    float amplitude = 1.0;
    float frequency = 1.0;
    float maxValue = 0.0;
    
    for (int i = 0; i < u_Octaves; i++)
    {
        float noise = worleyNoise(pos * frequency);
        noise = abs(noise * 2.0 - 1.0);
        
        value += noise * amplitude;
        maxValue += amplitude;
        
        amplitude *= u_Gain;
        frequency *= u_Lacunarity;
    }
    
    return value / maxValue;
}

// ============================================================================
// Ridged FBM
// ============================================================================

float ridgedFBM(vec3 pos)
{
    float value = 0.0;
    float amplitude = 1.0;
    float frequency = 1.0;
    float maxValue = 0.0;
    
    for (int i = 0; i < u_Octaves; i++)
    {
        float noise = worleyNoise(pos * frequency);
        noise = 1.0 - abs(noise * 2.0 - 1.0);
        
        value += noise * amplitude;
        maxValue += amplitude;
        
        amplitude *= u_Gain;
        frequency *= u_Lacunarity;
    }
    
    return value / maxValue;
}

// ============================================================================
// Perlin FBM
// ============================================================================

float perlinFBM(vec2 pos)
{
    float value = 0.0;
    float amplitude = 1.0;
    float frequency = 1.0;
    float maxValue = 0.0;
    
    for (int i = 0; i < u_Octaves; i++)
    {
        value += perlinNoise(pos * frequency) * amplitude;
        maxValue += amplitude;
        
        amplitude *= u_Gain;
        frequency *= u_Lacunarity;
    }
    
    return value / maxValue;
}

// ============================================================================
// Domain Warping - 도메인 왜곡
// ============================================================================

vec3 getDomainWarp(vec3 pos, float strength)
{
    // 3개의 독립적인 노이즈로 3D 왜곡 벡터 생성
    vec3 warp = vec3(
        perlinNoise(pos.xy + vec2(0.0, 0.0)) * 2.0 - 1.0,
        perlinNoise(pos.xy + vec2(5.2, 1.3)) * 2.0 - 1.0,
        perlinNoise(pos.yz + vec2(2.7, 9.1)) * 2.0 - 1.0
    ) * strength;
    
    return pos + warp;
}

float domainWarpedNoise(vec3 pos)
{
    // 1차 왜곡
    vec3 warpedPos = getDomainWarp(pos, 0.1);
    
    // 왜곡된 위치에서 노이즈 샘플링
    return worleyNoise(warpedPos);
}

// ============================================================================
// Cloud Noise - Perlin + Worley 조합
// ============================================================================

float cloudNoise(vec3 pos)
{
    float baseShape = perlinFBM(pos.xy * 0.5);
    float detail = worleyFBM(pos * 2.0);
    float erosion = worleyNoise(pos * 4.0);
    
    float cloud = baseShape;
    cloud = mix(cloud, cloud * detail, 0.7);
    cloud = cloud - (1.0 - erosion) * 0.2;
    
    return clamp(cloud, 0.0, 1.0);
}

// ============================================================================
// Advanced Cloud - Domain Warping + Billowy + Ridged (최고급 조합)
// ============================================================================

float advancedCloudNoise(vec3 pos)
{
    // 1. Domain Warping (1차 왜곡) - 큰 흐름
    vec3 warp1 = vec3(
        perlinNoise(pos.xy * 0.5) * 2.0 - 1.0,
        perlinNoise(pos.xy * 0.5 + vec2(5.2, 1.3)) * 2.0 - 1.0,
        0.0
    ) * 0.15;  // 왜곡 강도
    
    vec3 warpedPos1 = pos + warp1;
    
    // 2. Perlin FBM으로 큰 구름 덩어리 형태
    float baseShape = perlinFBM(warpedPos1.xy * 0.8);
    
    // 3. Domain Warping (2차 왜곡) - 디테일용
    vec3 warp2 = vec3(
        perlinNoise(warpedPos1.xy * 2.0) * 2.0 - 1.0,
        perlinNoise(warpedPos1.xy * 2.0 + vec2(3.7, 8.2)) * 2.0 - 1.0,
        0.0
    ) * 0.08;
    
    vec3 warpedPos2 = warpedPos1 + warp2;
    
    // 4. Billowy FBM - 뭉게구름 디테일 (둥근 형태)
    float billowy = 0.0;
    float amp = 1.0;
    float freq = 2.0;
    float maxVal = 0.0;
    
    for (int i = 0; i < min(u_Octaves, 4); i++)
    {
        float n = worleyNoise(warpedPos2 * freq);
        n = abs(n * 2.0 - 1.0);  // Billowy 변환
        billowy += n * amp;
        maxVal += amp;
        
        amp *= 0.6;
        freq *= 2.0;
    }
    billowy /= maxVal;
    
    // 5. Ridged - 날카로운 가장자리 (구름 경계 침식)
    float ridged = 0.0;
    amp = 1.0;
    freq = 3.0;
    maxVal = 0.0;
    
    for (int i = 0; i < min(u_Octaves, 3); i++)
    {
        float n = worleyNoise(warpedPos2 * freq);
        n = 1.0 - abs(n * 2.0 - 1.0);  // Ridged 변환
        ridged += n * amp;
        maxVal += amp;
        
        amp *= 0.5;
        freq *= 2.5;
    }
    ridged /= maxVal;
    
    // 6. 모든 레이어 조합
    float cloud = baseShape;
    
    // Billowy로 둥근 뭉게구름 형태 만들기
    cloud = mix(cloud, cloud * billowy, 0.75);
    
    // Ridged로 가장자리 침식
    cloud = cloud * (0.8 + ridged * 0.2);
    cloud = cloud - (1.0 - ridged) * 0.15;
    
    // 대비 강화
    cloud = pow(cloud, 0.9);
    
    return clamp(cloud, 0.0, 1.0);
}

// ============================================================================
// Main
// ============================================================================

void main()
{
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    
    if (pos.x >= u_Width || pos.y >= u_Height)
        return;
    
    vec2 uv = vec2(pos) / vec2(u_Width, u_Height);
    
    vec3 samplePos = vec3(
        (uv.x + u_OffsetX) / u_CellSize,
        (uv.y + u_OffsetY) / u_CellSize,
        float(u_Seed) * 0.1
    );
    
    float noise;
    
    if (u_CloudMode == 0)
    {
        // 기본 Worley
        noise = worleyNoise(samplePos);
    }
    else if (u_CloudMode == 8)
    {
        // Worley FBM
        noise = worleyFBM(samplePos);
    }
    else if (u_CloudMode == 2)
    {
        // Cloud (Perlin + Worley)
        noise = cloudNoise(samplePos);
    }
    else if (u_CloudMode == 3)
    {
        // Billowy (뭉게구름)
        noise = billowyNoise(samplePos);
    }
    else if (u_CloudMode == 4)
    {
        // Billowy FBM
        noise = billowyFBM(samplePos);
    }
    else if (u_CloudMode == 5)
    {
        // Ridged (날카로운 가장자리)
        noise = ridgedNoise(samplePos);
    }
    else if (u_CloudMode == 6)
    {
        // Ridged FBM
        noise = ridgedFBM(samplePos);
    }
    else if (u_CloudMode == 7)
    {
        // Domain Warped
        noise = domainWarpedNoise(samplePos);
    }
    else if (u_CloudMode == 1)
    {
        // Advanced Cloud (Domain Warping + Billowy + Ridged)
        noise = advancedCloudNoise(samplePos);
    }
    else
    {
        noise = 0.0;
    }
    
    imageStore(u_NoiseTexture, pos, vec4(noise, 0.0, 0.0, 1.0));
}