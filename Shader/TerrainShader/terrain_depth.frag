//-----------------------------------------------------------------------------
// terrain_depth.frag - 지형 깊이맵 생성용 프래그먼트 셰이더
//-----------------------------------------------------------------------------
#version 430 core

in float viewDepth;  // TES에서 전달받은 뷰 공간 깊이

void main()
{
    // 깊이 출력 (0.0 ~ 1.0 범위로 정규화)
    gl_FragDepth = clamp(viewDepth / 10000.0, 0.0, 1.0);
}