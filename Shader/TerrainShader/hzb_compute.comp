#version 430

layout(local_size_x = 64) in;

// ===== SSBO bindings =====
layout(std430, binding = 0) readonly buffer Transforms { 
    mat4 transforms[]; 
};

layout(std430, binding = 1) readonly buffer FrustumPassed { 
    uint frustumPassedIndices[]; 
};

layout(std430, binding = 2) readonly buffer FrustumCounter { 
    uint frustumPassedCount; 
};

struct AABB {
    vec3 min;
    float padding1;
    vec3 max;
    float padding2;
};

layout(std430, binding = 3) readonly buffer WorldAABBs { 
    AABB worldAABBs[];
};

layout(std430, binding = 4) writeonly buffer VisibleLOD0 { 
    uint visibleIndices_LOD0[]; 
};

layout(std430, binding = 5) buffer CounterLOD0 { 
    uint visibleCount_LOD0; 
};

layout(std430, binding = 6) writeonly buffer VisibleLOD1 { 
    uint visibleIndices_LOD1[]; 
};

layout(std430, binding = 7) buffer CounterLOD1 { 
    uint visibleCount_LOD1; 
};

layout(std430, binding = 8) writeonly buffer DebugDepths { 
    float debugDepths[]; 
};

// ===== Uniforms =====
uniform sampler2D hizTexture;
uniform mat4 vpMatrix;
uniform int maxMipLevel;
uniform vec3 cameraPosition;
uniform float lodDistance;
uniform vec2 screenSize;
uniform uint maxInstanceCount;
uniform float nearPlane;
uniform float farPlane;

const float EPSILON = 0.00001;

// ===== AABB 변환 및 깊이 계산 =====
void transformAABBToNDC(
    in vec3 worldMin, 
    in vec3 worldMax, 
    out vec2 ndcMin, 
    out vec2 ndcMax, 
    out float minDepthNDC,
    out float maxDepthNDC)
{
    // AABB 8개 코너
    vec3 corners[8];
    corners[0] = vec3(worldMin.x, worldMin.y, worldMin.z);
    corners[1] = vec3(worldMax.x, worldMin.y, worldMin.z);
    corners[2] = vec3(worldMin.x, worldMax.y, worldMin.z);
    corners[3] = vec3(worldMax.x, worldMax.y, worldMin.z);
    corners[4] = vec3(worldMin.x, worldMin.y, worldMax.z);
    corners[5] = vec3(worldMax.x, worldMin.y, worldMax.z);
    corners[6] = vec3(worldMin.x, worldMax.y, worldMax.z);
    corners[7] = vec3(worldMax.x, worldMax.y, worldMax.z);

    ndcMin = vec2(1.0);
    ndcMax = vec2(-1.0);
    minDepthNDC = 1.0;
    maxDepthNDC = 0.0;

    for (int i = 0; i < 8; i++)
    {
        // Clip space 변환
        vec4 clipPos = vpMatrix * vec4(corners[i], 1.0);
        
        // ✅ w가 0에 가까우면 스킵 (카메라 뒤쪽)
        if (clipPos.w <= 0.0001)
            continue;
        
        // 원근 나눗셈
        vec3 ndc = clipPos.xyz / clipPos.w;
        
        // NDC xy 범위
        ndcMin = min(ndcMin, ndc.xy);
        ndcMax = max(ndcMax, ndc.xy);
        
        // ✅ NDC 깊이 [0, 1] 범위로 변환
        float depthNDC = ndc.z * 0.5 + 0.5;
        depthNDC = clamp(depthNDC, 0.0, 1.0);
        
        minDepthNDC = min(minDepthNDC, depthNDC);
        maxDepthNDC = max(maxDepthNDC, depthNDC);
    }
}

// ===== HiZ Occlusion Test =====
bool isOccluded(vec2 ndcMin, vec2 ndcMax, float minDepthNDC)
{
    // NDC [-1,1] → UV [0,1]
    vec2 uvMin = ndcMin * 0.5 + 0.5;
    vec2 uvMax = ndcMax * 0.5 + 0.5;
    
    // 화면 밖 체크
    if (uvMax.x < 0.0 || uvMin.x > 1.0 || uvMax.y < 0.0 || uvMin.y > 1.0)
        return true;
    
    // 클램핑
    uvMin = clamp(uvMin, 0.0, 1.0);
    uvMax = clamp(uvMax, 0.0, 1.0);
    
    // 스크린 공간 크기
    vec2 size = (uvMax - uvMin) * screenSize;
    float maxSize = max(size.x, size.y);
    
    // 작은 객체는 보수적으로 처리
    if (maxSize < 1.0)
        return false;
    
    // 밉맵 레벨 계산
    float mipLevel = ceil(log2(maxSize));
    mipLevel = clamp(mipLevel, 0.0, float(maxMipLevel));
    
    // HZB 4코너 샘플링
    vec2 uv00 = uvMin;
    vec2 uv01 = vec2(uvMax.x, uvMin.y);
    vec2 uv10 = vec2(uvMin.x, uvMax.y);
    vec2 uv11 = uvMax;
    
    float depth00 = textureLod(hizTexture, uv00, mipLevel).r;
    float depth01 = textureLod(hizTexture, uv01, mipLevel).r;
    float depth10 = textureLod(hizTexture, uv10, mipLevel).r;
    float depth11 = textureLod(hizTexture, uv11, mipLevel).r;
    
    // 최대 깊이값 (가장 먼 지형)
    float maxHZBDepth = max(max(depth00, depth01), max(depth10, depth11));
    
    // ✅ 깊이 비교
    return minDepthNDC > maxHZBDepth + EPSILON;
}

// ===== Main =====
void main()
{
    uint threadID = gl_GlobalInvocationID.x;
    
    if (threadID >= frustumPassedCount) return;
    
    uint instanceIndex = frustumPassedIndices[threadID];
    if (instanceIndex >= maxInstanceCount) return;
    
    // Transform 및 AABB
    mat4 modelMatrix = transforms[instanceIndex];
    vec3 worldPos = modelMatrix[3].xyz;
    
    AABB aabb = worldAABBs[instanceIndex];
    vec3 worldMin = aabb.min;
    vec3 worldMax = aabb.max;
    
    // AABB 변환
    vec2 ndcMin, ndcMax;
    float minDepthNDC, maxDepthNDC;
    
    transformAABBToNDC(worldMin, worldMax, ndcMin, ndcMax, 
                       minDepthNDC, maxDepthNDC);
    
    // ✅ 디버그: NDC 깊이를 그대로 저장 (0~1 범위)
    // 시각화 셰이더에서 [0,1] 범위로 색상 매핑
    debugDepths[instanceIndex] = minDepthNDC;
    
    // HiZ Occlusion Test
    bool occluded = isOccluded(ndcMin, ndcMax, minDepthNDC);
    
    if (!occluded)
    {
        float distance = length(worldPos - cameraPosition);
        
        if (distance < lodDistance)
        {
            uint index = atomicAdd(visibleCount_LOD0, 1);
            visibleIndices_LOD0[index] = instanceIndex;
        }
        else
        {
            uint index = atomicAdd(visibleCount_LOD1, 1);
            visibleIndices_LOD1[index] = instanceIndex;
        }
    }
}