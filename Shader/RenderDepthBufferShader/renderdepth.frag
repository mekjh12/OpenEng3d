#version 420

// ============================================================================
// 렌더 버퍼 깊이 시각화 셰이더
// ============================================================================
// 
// [현재 시스템 좌표계]
// - 뷰 공간: 앞쪽 = 양수 Z, 뒤쪽 = 음수 Z (표준 OpenGL과 반대)
// - 깊이 저장: viewPos.z / 10000.0 → [0, 1] 선형 매핑
// - 범위: 0m ~ 10km
//
// [깊이 버퍼 형식]
// - R32f (32비트 부동소수점)
// - 직접 저장: gl_FragDepth = viewPos.z / 10000.0
// - 특징: 선형 분포, 비표준 투영의 비선형 문제 없음
//
// [색상 구간]
// - 파란색: 0 ~ 100m (매우 가까움)
// - 청록색: 100 ~ 500m (가까움)
// - 초록색: 500 ~ 1000m (중간)
// - 노란~빨강: 1000m 이상 (멀음)
//
// ============================================================================

uniform sampler2D DepthTexture;
uniform float CameraNear;
uniform float CameraFar;
uniform bool IsPerspective;

in vec2 TexCoord;
out vec4 fragColor;

// ============================================================================
// 현재 시스템용 깊이 처리
// ============================================================================
// 우리는 viewPos.z / 10000.0으로 이미 선형 깊이를 저장했으므로
// 텍스처에서 읽은 값을 그대로 사용
// ============================================================================
float GetLinearDepth(vec2 uv)
{
    // 렌더 버퍼에서 깊이 읽기
    // 이미 [0, 1] 범위로 정규화된 선형 깊이
    // 0.0 = 0m (가장 가까움)
    // 0.5 = 5km (중간)
    // 1.0 = 10km (최대 거리)
    float depth = texture(DepthTexture, uv).r;
    
    return depth;
}

// ============================================================================
// 깊이 → 색상 변환 (히트맵)
// ============================================================================
// 구간별 색상 매핑:
// - 0 ~ 100m:    파란색 → 청록색
// - 100 ~ 500m:  청록색 → 초록색
// - 500 ~ 1000m: 초록색 → 노란색
// - 1000m 이상:  노란색 → 빨간색
// ============================================================================
vec3 DepthToColor(float normalizedDepth)
{
    // [0, 1] → [0, 10000m] 변환
    float depthMeters = normalizedDepth * 10000.0;
    
    vec3 color;
    
    if (depthMeters < 100.0)
    {
        // 0 ~ 100m: 파란색 → 청록색
        float t = depthMeters / 100.0;
        color = vec3(0.0, t, 1.0);
    }
    else if (depthMeters < 500.0)
    {
        // 100 ~ 500m: 청록색 → 초록색
        float t = (depthMeters - 100.0) / 400.0;
        color = vec3(0.0, 1.0, 1.0 - t);
    }
    else if (depthMeters < 1000.0)
    {
        // 500 ~ 1000m: 초록색 → 노란색
        float t = (depthMeters - 500.0) / 500.0;
        color = vec3(t, 1.0, 0.0);
    }
    else
    {
        // 1000m 이상: 노란색 → 빨간색
        // 1000m = 노란색, 10000m = 빨간색
        float t = clamp((depthMeters - 1000.0) / 9000.0, 0.0, 1.0);
        color = vec3(1.0, 1.0 - t, 0.0);
    }
    
    return color;
}

void main(void)
{
    // ============================================================================
    // 메인 로직
    // ============================================================================
    // 현재 시스템은 항상 선형 깊이를 저장하므로
    // IsPerspective 플래그와 관계없이 동일하게 처리
    // ============================================================================
    
    // 현재 시스템: 이미 선형 깊이가 저장되어 있음
    // viewPos.z / 10000.0 → [0, 1]
    float depth = GetLinearDepth(TexCoord);
    
    // 안전을 위한 클램핑
    depth = clamp(depth, 0.0, 1.0);
    
    // 색상으로 변환하여 출력
    vec3 color = DepthToColor(depth);
    fragColor = vec4(color, 1.0);
    
    // ============================================================================
    // 디버그 정보
    // ============================================================================
    // depth = 0.01 (0.01 * 10000 = 100m)   → 청록색
    // depth = 0.05 (0.05 * 10000 = 500m)   → 초록색
    // depth = 0.10 (0.10 * 10000 = 1000m)  → 노란색
    // depth = 0.50 (0.50 * 10000 = 5000m)  → 주황색
    // depth = 1.00 (1.00 * 10000 = 10000m) → 빨간색
    // ============================================================================
}