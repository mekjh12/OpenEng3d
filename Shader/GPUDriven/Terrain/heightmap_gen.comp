#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 2) uniform sampler2D baseHeightmap;
layout(rgba32f, binding = 0) readonly  uniform image2D readBuffer;
layout(rgba32f, binding = 1) writeonly uniform image2D writeBuffer;

uniform int   mode = 0;
uniform float gaussianSigma = 3.0;
uniform int   blurRadius = 8;
uniform int   blurPass = 0;  // 0=수평, 1=수직

// ─────────────────────────────────────────────
// Bicubic (Catmull-Rom) 보간
// ─────────────────────────────────────────────
float cubicWeight(float x)
{
    float ax  = abs(x);
    float ax2 = ax * ax;
    float ax3 = ax2 * ax;
    
    if (ax <= 1.0) 
        return 1.5 * ax3 - 2.5 * ax2 + 1.0;
    if (ax <= 2.0) 
        return -0.5 * ax3 + 2.5 * ax2 - 4.0 * ax + 2.0;
    
    return 0.0;
}

/// sampler2D에서 Bicubic 샘플링 (텍스처용)
float bicubicSample(sampler2D tex, vec2 uv)
{
    ivec2 texSize   = textureSize(tex, 0);
    vec2  texelPos  = uv * vec2(texSize) - 0.5;
    ivec2 texelBase = ivec2(floor(texelPos));
    vec2  frac      = texelPos - vec2(texelBase);

    float result = 0.0;
    for (int j = -1; j <= 2; j++)
    {
        float wy = cubicWeight(frac.y - float(j));
        for (int i = -1; i <= 2; i++)
        {
            ivec2 coord = clamp(texelBase + ivec2(i, j), ivec2(0), texSize - 1);
            float wx    = cubicWeight(frac.x - float(i));
            result     += texelFetch(tex, coord, 0).r * wx * wy;
        }
    }
    return result;
}

/// image2D에서 Bicubic 샘플링 (컴퓨트 버퍼용)
/// 현재 사용되지 않지만 향후 멀티패스 업스케일링에 활용 가능
float bicubicSampleFromImage(ivec2 targetCoord, ivec2 targetSize, ivec2 sourceSize)
{
    vec2 uv = (vec2(targetCoord) + 0.5) / vec2(targetSize);
    vec2 texelPos  = uv * vec2(sourceSize) - 0.5;
    ivec2 texelBase = ivec2(floor(texelPos));
    vec2 frac = texelPos - vec2(texelBase);

    float result = 0.0;
    for (int j = -1; j <= 2; j++)
    {
        float wy = cubicWeight(frac.y - float(j));
        for (int i = -1; i <= 2; i++)
        {
            ivec2 coord = clamp(texelBase + ivec2(i, j), ivec2(0), sourceSize - 1);
            float wx = cubicWeight(frac.x - float(i));
            result += imageLoad(readBuffer, coord).r * wx * wy;
        }
    }
    return result;
}

// ─────────────────────────────────────────────
// Gaussian 가중치
// ─────────────────────────────────────────────
float gaussianWeight(float x, float sigma)
{
    return exp(-0.5 * x * x / (sigma * sigma));
}

// ─────────────────────────────────────────────
// Main
// ─────────────────────────────────────────────
void main()
{
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size   = imageSize(writeBuffer);

    // 범위 체크
    if (coords.x >= size.x || coords.y >= size.y) 
        return;

    vec2 uv = (vec2(coords) + 0.5) / vec2(size);
    float resultHeight = 0.0;

    // ─── Mode 0: Bilinear 업스케일링 (baseHeightmap -> writeBuffer) ───
    if (mode == 0)
    {
        resultHeight = texture(baseHeightmap, uv).r;
        resultHeight = resultHeight;
    }
    // ─── Mode 1: Bicubic 보간 (baseHeightmap -> writeBuffer) ──────────
    else if (mode == 1)
    {
        resultHeight = bicubicSample(baseHeightmap, uv);
    }
    // ─── Mode 2: Separable Gaussian 블러 (readBuffer -> writeBuffer) ──
    else if (mode == 2)
    {
        float weightSum = 0.0;

        if (blurPass == 0)  // 수평 블러
        {
            for (int i = -blurRadius; i <= blurRadius; i++)
            {
                ivec2 sampleCoord = ivec2(clamp(coords.x + i, 0, size.x - 1), coords.y);
                float weight = gaussianWeight(float(i), gaussianSigma);
                resultHeight += imageLoad(readBuffer, sampleCoord).r * weight;
                weightSum += weight;
            }
        }
        else  // 수직 블러
        {
            for (int i = -blurRadius; i <= blurRadius; i++)
            {
                ivec2 sampleCoord = ivec2(coords.x, clamp(coords.y + i, 0, size.y - 1));
                float weight = gaussianWeight(float(i), gaussianSigma);
                resultHeight += imageLoad(readBuffer, sampleCoord).r * weight;
                weightSum += weight;
            }
        }

        resultHeight /= weightSum;
    }

    // 최종 출력 (grayscale로 RGBA에 모두 같은 값 저장)
    imageStore(writeBuffer, coords, vec4(resultHeight, resultHeight, resultHeight, 1.0));
}