//-----------------------------------------------------------------------------
// post.gs.glsl - 풀스크린 쿼드 생성 (Deferred Shading용)
//-----------------------------------------------------------------------------
// Point 입력을 받아 전체 화면을 덮는 삼각형 스트립 생성
// NDC 좌표 (-1,-1) ~ (1,1) 전체를 커버
//-----------------------------------------------------------------------------
#version 430 core

layout(points) in;
layout(triangle_strip, max_vertices = 4) out;

out vec2 TexCoord;

void main() 
{
    // ============================================
    // 우상 (1, 1)
    // ============================================
    gl_Position = vec4(1.0, 1.0, 0.5, 1.0);
    TexCoord = vec2(1.0, 1.0);
    EmitVertex();
    
    // ============================================
    // 좌상 (-1, 1)
    // ============================================
    gl_Position = vec4(-1.0, 1.0, 0.5, 1.0);
    TexCoord = vec2(0.0, 1.0);
    EmitVertex();
    
    // ============================================
    // 우하 (1, -1)
    // ============================================
    gl_Position = vec4(1.0, -1.0, 0.5, 1.0);
    TexCoord = vec2(1.0, 0.0);
    EmitVertex();
    
    // ============================================
    // 좌하 (-1, -1)
    // ============================================
    gl_Position = vec4(-1.0, -1.0, 0.5, 1.0);
    TexCoord = vec2(0.0, 0.0);
    EmitVertex();
    
    EndPrimitive();
}