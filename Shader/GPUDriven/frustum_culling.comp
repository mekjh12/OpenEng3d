#version 450 core
layout(local_size_x = 256) in;

struct AABB {
    vec3 min;
    float padding1;
    vec3 max;
    float padding2;
};

// SSBO (binding 5 제거!)
layout(std430, binding = 0) buffer AABBBuffer {
    AABB aabbs[];
};

layout(std430, binding = 1) buffer VisibleIndicesBuffer_LOD0 {
    int visibleIndices_LOD0[];
};

layout(std430, binding = 2) buffer CounterBuffer_LOD0 {
    uint visibleCount_LOD0;
};

layout(std430, binding = 3) buffer VisibleIndicesBuffer_LOD1 {
    int visibleIndices_LOD1[];
};

layout(std430, binding = 4) buffer CounterBuffer_LOD1 {
    uint visibleCount_LOD1;
};

// 유니폼
uniform vec4 uFrustumPlanes[6];
uniform vec3 uCameraPosition;
uniform float uLODDistance;

bool ContactTestAABBPlane(AABB aabb, vec4 plane) 
{
    vec3 center = (aabb.min + aabb.max) * 0.5;
    vec3 extent = (aabb.max - aabb.min) * 0.5;
    float dist = dot(plane.xyz, center) + plane.w;
    float radius = dot(extent, abs(plane.xyz));
    return (dist + radius) >= 0.0;
}

// 프러스텀 평면과 AABB의 충돌 검사
bool IsInsideFrustum(AABB aabb) 
{
    if (!ContactTestAABBPlane(aabb, uFrustumPlanes[4])) return false; // 근거리 평면
    if (!ContactTestAABBPlane(aabb, uFrustumPlanes[5])) return false; // 원거리 평면
    if (!ContactTestAABBPlane(aabb, uFrustumPlanes[0])) return false; // 오른쪽 평면
    if (!ContactTestAABBPlane(aabb, uFrustumPlanes[2])) return false; // 왼쪽 평면
    if (!ContactTestAABBPlane(aabb, uFrustumPlanes[1])) return false; // 하단 평면
    if (!ContactTestAABBPlane(aabb, uFrustumPlanes[3])) return false; // 상단 평면
    return true;
}

void main() 
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= 90000) return;

    // Frustum 테스트
    if (IsInsideFrustum(aabbs[index])) 
    {
        vec3 center = (aabbs[index].min + aabbs[index].max) * 0.5;
        float distance = length(uCameraPosition - center);
        
        // LOD 선택 (거리 기반)
        if (distance < 100)
        {
            // LOD0: 전체 메시
            uint slot = atomicAdd(visibleCount_LOD0, 1);
            visibleIndices_LOD0[slot] = int(index);
        } 
        else 
        {
            // LOD1: 빌보드
            uint slot = atomicAdd(visibleCount_LOD1, 1);
            visibleIndices_LOD1[slot] = int(index);
        }
    }
}
