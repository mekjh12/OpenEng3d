#version 450 core
layout(local_size_x = 64) in;

#define MAX_BATCHES 64
const float MAX_DEPTH_METERS = 10000.0;
const float DEPTH_EPSILON_BASE = 0.001;  // 10m

// ===== 구조체 정의 =====
struct AABB {vec3 min; float padding1; vec3 max; float padding2;};
struct InstanceModelMatrixData {mat4 modelMatrix; mat4 normalMatrix;};

// ===== 입력 버퍼 =====
layout(std430, binding = 0) readonly buffer TransformBuffer {InstanceModelMatrixData transforms[];};
layout(std430, binding = 1) readonly buffer FrustumPassedBuffer {int frustumPassedIndices[];};
layout(std430, binding = 2) readonly buffer FrustumCounterBuffer {uint frustumPassedCount;};
layout(std430, binding = 3) readonly buffer WorldAABBBuffer {AABB worldAABBs[];};
layout(std430, binding = 4) readonly buffer BatchIDBuffer {uint batchIDs[];};

// ===== 출력 버퍼 =====
layout(std430, binding = 5) buffer VisibleIndicesLOD0Buffer {int visibleIndices_LOD0[];};
layout(std430, binding = 6) buffer VisibleCountsLOD0Buffer {uint visibleCounts_LOD0[];};
layout(std430, binding = 7) buffer VisibleIndicesLOD1Buffer {int visibleIndices_LOD1[];};
layout(std430, binding = 8) buffer VisibleCountsLOD1Buffer {uint visibleCounts_LOD1[];};
layout(std430, binding = 9) buffer VisibleIndicesLOD2Buffer {int visibleIndices_LOD2[];};
layout(std430, binding = 10) buffer VisibleCountsLOD2Buffer {uint visibleCounts_LOD2[];};
layout(std430, binding = 11) buffer VisibleIndicesLOD3Buffer {int visibleIndices_LOD3[];};
layout(std430, binding = 12) buffer VisibleCountsLOD3Buffer {uint visibleCounts_LOD3[];};

// ===== HiZ 텍스처 =====
uniform sampler2D u_hizTexture0;
uniform sampler2D u_hizTexture1;
uniform sampler2D u_hizTexture2;
uniform sampler2D u_hizTexture3;
uniform sampler2D u_hizTexture4;
uniform sampler2D u_hizTexture5;
uniform sampler2D u_hizTexture6;
uniform sampler2D u_hizTexture7;
uniform sampler2D u_hizTexture8;
uniform sampler2D u_hizTexture9;
uniform sampler2D u_hizTexture10;

// ===== Uniform 변수 =====
uniform mat4 vp;
uniform mat4 view;
uniform int u_maxMipLevel;
uniform vec3 u_cameraPosition;
uniform vec2 u_screenSize;
uniform int u_maxInstanceCount;
uniform float u_cameraNear;
uniform float u_cameraFar;

// ===== Batch 관련 Uniform =====
uniform float batchLODs[64];
uniform uint batchStarts[64];
uniform uint batchCounts[64];

// mip level에 따라 적절한 텍스처에서 샘플링
float sampleHiZTexture(int mipLevel, vec2 uv)
{
    if (mipLevel == 0) return texture(u_hizTexture0, uv).r;
    if (mipLevel == 1) return texture(u_hizTexture1, uv).r;
    if (mipLevel == 2) return texture(u_hizTexture2, uv).r;
    if (mipLevel == 3) return texture(u_hizTexture3, uv).r;
    if (mipLevel == 4) return texture(u_hizTexture4, uv).r;
    if (mipLevel == 5) return texture(u_hizTexture5, uv).r;
    if (mipLevel == 6) return texture(u_hizTexture6, uv).r;
    if (mipLevel == 7) return texture(u_hizTexture7, uv).r;
    if (mipLevel == 8) return texture(u_hizTexture8, uv).r;
    if (mipLevel == 9) return texture(u_hizTexture9, uv).r;
    return texture(u_hizTexture10, uv).r;
}

// AABB를 화면에 투영
bool projectAABB(AABB worldAABB, out vec2 minScreen, out vec2 maxScreen, out float minDepth, out vec3 worldCenter)
{
    vec3 corners[8];
    corners[0] = vec3(worldAABB.min.x, worldAABB.min.y, worldAABB.min.z);
    corners[1] = vec3(worldAABB.max.x, worldAABB.min.y, worldAABB.min.z);
    corners[2] = vec3(worldAABB.min.x, worldAABB.max.y, worldAABB.min.z);
    corners[3] = vec3(worldAABB.max.x, worldAABB.max.y, worldAABB.min.z);
    corners[4] = vec3(worldAABB.min.x, worldAABB.min.y, worldAABB.max.z);
    corners[5] = vec3(worldAABB.max.x, worldAABB.min.y, worldAABB.max.z);
    corners[6] = vec3(worldAABB.min.x, worldAABB.max.y, worldAABB.max.z);
    corners[7] = vec3(worldAABB.max.x, worldAABB.max.y, worldAABB.max.z);

    worldCenter = (worldAABB.min + worldAABB.max) * 0.5;

    minScreen = vec2(10.0);
    maxScreen = vec2(-10.0);
    minDepth = 1e10;
    int validCount = 0;

    for (int i = 0; i < 8; i++)
    {
        vec4 viewPos = view * vec4(corners[i], 1.0);
        vec4 clipPos = vp * vec4(corners[i], 1.0);
        
        // ✅ 카메라 뒤의 점 명시적으로 제외
        if (viewPos.z >= 0.0) continue;  // OpenGL: 양수 = 뒤
        
        // 클립 공간 체크 (안전장치)
        if (clipPos.w <= 0.01) continue;
        
        vec3 ndc = clipPos.xyz / clipPos.w;
        
        // ✅ 깊이 계산 (이제 abs() 불필요, 항상 음수)
        float linearDepth = clamp(-viewPos.z / MAX_DEPTH_METERS, 0.0, 1.0);
        
        // NDC를 스크린 좌표(0~1)로 변환
        vec2 uv = ndc.xy * 0.5 + 0.5;
        
        minScreen = min(minScreen, uv);
        maxScreen = max(maxScreen, uv);
        minDepth = min(minDepth, linearDepth);
        validCount++;
    }
    
    minScreen = clamp(minScreen, 0.0, 1.0);
    maxScreen = clamp(maxScreen, 0.0, 1.0);
    
    return true;
}

// ✅ HiZ 기반 계층적 오클루전 테스트
bool hierarchicalOcclusionTest(vec2 minScreen, vec2 maxScreen, float minDepth)
{
    return true;

    // 1. 화면 크기 계산
    vec2 sizeUV = maxScreen - minScreen;
    vec2 sizePixels = sizeUV * u_screenSize;
    float maxSize = max(sizePixels.x, sizePixels.y);

    // 너무 작으면 컬링
    if (maxSize <= 1.0) return false;
    
    // 2. 거리 기반 Adaptive Epsilon
    float adaptiveEpsilon = max(minDepth * 0.015, DEPTH_EPSILON_BASE);
    
    // 3. 4개 코너 샘플 포인트 준비
    vec2 samples[4];
    samples[0] = minScreen;
    samples[1] = vec2(maxScreen.x, minScreen.y);
    samples[2] = vec2(minScreen.x, maxScreen.y);
    samples[3] = maxScreen;
    
    // ✅ 4. 낮은 해상도(높은 mip)부터 테스트!
    for (int mip = u_maxMipLevel; mip >= 0; mip--)
    {
        bool anyVisible = false;
        
        // 4개 코너 샘플링
        for (int i = 0; i < 4; i++) {
            float hizDepth = sampleHiZTexture(mip, samples[i]);
            
            // ✅ 올바른 비교: 객체가 HiZ보다 앞에 있으면 보임
            if (minDepth <= hizDepth + adaptiveEpsilon) {
                anyVisible = true;
                break;
            }
        }
        
        // ✅ 이 레벨에서 모두 가려졌으면 즉시 컬링!
        if (!anyVisible) {
            return false;
        }
    }
    
    // ✅ 모든 레벨을 통과했으면 렌더링
    return true;
}

void main()
{
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= frustumPassedCount) return;
    
    int instanceIdx = frustumPassedIndices[gid];
    if (instanceIdx < 0 || instanceIdx >= u_maxInstanceCount) return;
    
    uint batchID = batchIDs[instanceIdx];    
    if (batchID >= MAX_BATCHES) return;

    float lodDistance = batchLODs[batchID];
    uint batchStart = batchStarts[batchID];
    uint batchMaxCount = batchCounts[batchID];
    
    // ===== AABB 투영 =====
    AABB worldAABB = worldAABBs[instanceIdx];
    vec2 minScreen, maxScreen;
    float minDepth;
    vec3 worldCenter;
    
    if (!projectAABB(worldAABB, minScreen, maxScreen, minDepth, worldCenter)) return;

    // ===== HiZ 테스트 =====
    if (!hierarchicalOcclusionTest(minScreen, maxScreen, minDepth)) return;

    // ===== LOD 결정 =====
    float distance = length(u_cameraPosition - worldCenter);
    bool isLOD0 =   0 < distance && distance <= 50;
    bool isLOD1 =  50 < distance && distance <= 150;
    bool isLOD2 = 150 < distance && distance <= 450;
    bool isLOD3 = 450 < distance;

    // ===== 결과 기록 =====
    if (isLOD0) 
    {        
        uint relativeSlot = atomicAdd(visibleCounts_LOD0[batchID], 1);
        if (relativeSlot < batchMaxCount) 
        {
            uint absoluteSlot = batchStart + relativeSlot;
            visibleIndices_LOD0[absoluteSlot] = instanceIdx;
        }
    } 

    if (isLOD1)  
    {
        uint relativeSlot = atomicAdd(visibleCounts_LOD1[batchID], 1);
        if (relativeSlot < batchMaxCount) 
        {
            uint absoluteSlot = batchStart + relativeSlot;
            visibleIndices_LOD1[absoluteSlot] = instanceIdx;
        }
    }

    if (isLOD2)  
    {
        uint relativeSlot = atomicAdd(visibleCounts_LOD2[batchID], 1);
        if (relativeSlot < batchMaxCount) 
        {
            uint absoluteSlot = batchStart + relativeSlot;
            visibleIndices_LOD2[absoluteSlot] = instanceIdx;
        }
    }

    if (isLOD3)  
    {
        uint relativeSlot = atomicAdd(visibleCounts_LOD3[batchID], 1);
        if (relativeSlot < batchMaxCount) 
        {
            uint absoluteSlot = batchStart + relativeSlot;
            visibleIndices_LOD3[absoluteSlot] = instanceIdx;
        }
    }
}