#version 430 core
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, r32f) uniform readonly image2D u_InputHeightMap;
layout(binding = 1, r32f) uniform writeonly image2D u_OutputBlurredMap;

uniform int u_Width;
uniform int u_Height;
uniform float u_BlurStrength;

void main() 
{
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
    
    if (coords.x >= u_Width || coords.y >= u_Height) 
        return;
    
    float originalHeight = imageLoad(u_InputHeightMap, coords).r;
    
    if (isnan(originalHeight) || isinf(originalHeight))
    {
        imageStore(u_OutputBlurredMap, coords, vec4(originalHeight, 0.0, 0.0, 1.0));
        return;
    }
    
    // ⭐ 5x5 가우시안 커널 (정규화됨, 총합=1.0)
    float kernel[25] = float[](
        0.003765, 0.015019, 0.023792, 0.015019, 0.003765,
        0.015019, 0.059912, 0.094907, 0.059912, 0.015019,
        0.023792, 0.094907, 0.150342, 0.094907, 0.023792,
        0.015019, 0.059912, 0.094907, 0.059912, 0.015019,
        0.003765, 0.015019, 0.023792, 0.015019, 0.003765
    );
    
    float blurredHeight = 0.0;
    float weightSum = 0.0;
    int index = 0;
    
    // ⭐ -2 ~ +2 범위로 확장
    for (int y = -2; y <= 2; y++) 
    {
        for (int x = -2; x <= 2; x++) 
        {
            ivec2 sampleCoords = coords + ivec2(x, y);
            
            // 경계 체크
            if (sampleCoords.x < 0 || sampleCoords.x >= u_Width ||
                sampleCoords.y < 0 || sampleCoords.y >= u_Height)
            {
                index++;
                continue;
            }
            
            float h = imageLoad(u_InputHeightMap, sampleCoords).r;
            
            // NaN/Inf 처리
            if (isnan(h) || isinf(h))
            {
                h = originalHeight;
            }
            
            blurredHeight += h * kernel[index];
            weightSum += kernel[index];
            index++;
        }
    }
    
    // 정규화
    if (weightSum > 0.0001)
    {
        blurredHeight /= weightSum;
    }
    else
    {
        blurredHeight = originalHeight;
    }
    
    // 안전성 체크
    if (isnan(blurredHeight) || isinf(blurredHeight))
    {
        blurredHeight = originalHeight;
    }
    
    blurredHeight = clamp(blurredHeight, 0.0, 1.0);
    
    // 원본과 블러 결과 혼합
    float finalHeight = mix(originalHeight, blurredHeight, u_BlurStrength);
    
    finalHeight = clamp(finalHeight, 0.0, 1.0);
    
    imageStore(u_OutputBlurredMap, coords, vec4(finalHeight, 0.0, 0.0, 1.0));
}