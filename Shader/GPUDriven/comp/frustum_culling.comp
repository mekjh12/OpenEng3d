#version 450 core
layout(local_size_x = 256) in;

// 버퍼 정의
struct AABB {vec3 min; float padding1; vec3 max; float padding2;};

// 버퍼 바인딩
layout(std430, binding = 0) buffer AABBBuffer { AABB aabbs[];};
layout(std430, binding = 1) buffer FrustumPassedBuffer { int frustumPassedIndices[];};
layout(std430, binding = 2) buffer FrustumCounterBuffer { uint frustumPassedCount;};

// 유니폼
uniform vec4 uFrustumPlanes[6];
uniform int u_maxInstanceCount;

bool ContactTestAABBPlane(AABB aabb, vec4 plane) 
{
    vec3 center = (aabb.min + aabb.max) * 0.5;
    vec3 extent = (aabb.max - aabb.min) * 0.5;
    float dist = dot(plane.xyz, center) + plane.w;
    float radius = dot(extent, abs(plane.xyz));
    return (dist + radius) >= 0.0;
}

bool IsInsideFrustum(AABB aabb) 
{
    if (!ContactTestAABBPlane(aabb, uFrustumPlanes[4])) return false; // Near
    if (!ContactTestAABBPlane(aabb, uFrustumPlanes[5])) return false; // Far
    if (!ContactTestAABBPlane(aabb, uFrustumPlanes[0])) return false; // Right
    if (!ContactTestAABBPlane(aabb, uFrustumPlanes[2])) return false; // Left
    if (!ContactTestAABBPlane(aabb, uFrustumPlanes[1])) return false; // Bottom
    if (!ContactTestAABBPlane(aabb, uFrustumPlanes[3])) return false; // Top
    return true;
}

void main() 
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= u_maxInstanceCount) return;
    
    AABB aabb = aabbs[index];
    
    // ✅ 유효하지 않은 AABB 필터링 (min > max는 무효)
    if (aabb.min.x > aabb.max.x || 
        aabb.min.y > aabb.max.y || 
        aabb.min.z > aabb.max.z) return;
    
    // ✅ 너무 큰 AABB도 필터링 (쓰레기 데이터)
    vec3 size = aabb.max - aabb.min;
    if (size.x > 1000.0 || size.y > 1000.0 || size.z > 1000.0) return;
    
    // Frustum 테스트만 수행 (LOD 구분 없음)
    if (IsInsideFrustum(aabbs[index])) 
    {
        uint slot = atomicAdd(frustumPassedCount, 1);
        if (slot < u_maxInstanceCount) {
            frustumPassedIndices[slot] = int(index);
        }
    }
}