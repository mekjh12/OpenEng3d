#version 450 core

// ====================================================================
// Indirect Draw Command Writer Compute Shader
// ====================================================================
// [개요]
// Frustum/Occlusion Culling 결과로 나온 각 배치별 가시적인 인스턴스 개수를
// GPU Indirect Draw Command 버퍼에 기록하는 컴퓨트 셰이더입니다.
//
// [동작 방식]
// 1. 각 스레드가 하나의 배치(Batch)를 담당
// 2. 해당 배치의 LOD0~LOD3 가시 인스턴스 개수를 읽음
// 3. Indirect Command 구조체의 instanceCount 필드에 기록
// 4. GPU가 glMultiDrawElementsIndirect로 직접 렌더링 수행
//
// [Indirect Draw Command 구조]
// struct DrawElementsIndirectCommand {
//     uint count;          // 인덱스 개수
//     uint instanceCount;  // 인스턴스 개수 ← 여기에 기록
//     uint firstIndex;     // 시작 인덱스
//     uint baseVertex;     // 베이스 버텍스
//     uint baseInstance;   // 베이스 인스턴스
// };
// ====================================================================

// ====================================================================
// 컴퓨트 셰이더 워크그룹 설정 (배치당 1개 스레드)
// ====================================================================
layout(local_size_x = 1) in;

// ====================================================================
// GPU 버퍼 바인딩 - 각 LOD별 가시 인스턴스 개수 (읽기)
// ====================================================================
layout(std430, binding = 6) readonly buffer VisibleCounts_LOD0 {
    uint visibleCounts_LOD0[];  // 배치별 LOD0 가시 개수
};

layout(std430, binding = 8) readonly buffer VisibleCounts_LOD1 {
    uint visibleCounts_LOD1[];  // 배치별 LOD1 가시 개수
};

layout(std430, binding = 10) readonly buffer VisibleCounts_LOD2 {
    uint visibleCounts_LOD2[];  // 배치별 LOD2 가시 개수
};

layout(std430, binding = 12) readonly buffer VisibleCounts_LOD3 {
    uint visibleCounts_LOD3[];  // 배치별 LOD3 가시 개수
};

// ====================================================================
// Indirect Command Buffer (쓰기) - uint 배열로 바이트 단위 접근
// ====================================================================
layout(std430, binding = 13) writeonly buffer IndirectCommands {
    uint indirectCommands[];  // DrawElementsIndirectCommand 배열
};

// ====================================================================
// 유니폼 변수
// ====================================================================
uniform uint numBatches;                        // 총 배치 개수
uniform uint batchCommandStartIndices[64];      // 각 배치의 명령 시작 오프셋 (바이트)

// ====================================================================
// 메인 함수 - 각 스레드가 하나의 배치를 처리
// ====================================================================
void main() {
    uint batchID = gl_GlobalInvocationID.x;
    if (batchID >= numBatches) return;
    
    // 바이트 오프셋을 uint 인덱스로 변환 (1 uint = 4 bytes)
    uint byteOffset = batchCommandStartIndices[batchID];
    uint baseIndex = byteOffset / 4;
    
    // 현재 배치의 각 LOD별 가시 인스턴스 개수 읽기
    uint visibleLOD0 = visibleCounts_LOD0[batchID];
    uint visibleLOD1 = visibleCounts_LOD1[batchID];
    uint visibleLOD2 = visibleCounts_LOD2[batchID];
    uint visibleLOD3 = visibleCounts_LOD3[batchID];
    
    // LOD0 Command: baseIndex + 0~3 (16 bytes)
    // instanceCount는 두 번째 uint (인덱스 1)
    indirectCommands[baseIndex + 0 + 1] = visibleLOD0;
    
    // LOD1 Command: baseIndex + 4~7 (16 bytes)
    indirectCommands[baseIndex + 4 + 1] = visibleLOD1;
    
    // LOD2 Command: baseIndex + 8~11 (16 bytes)
    indirectCommands[baseIndex + 8 + 1] = visibleLOD2;
    
    // LOD3 Command: baseIndex + 12~15 (16 bytes)
    indirectCommands[baseIndex + 12 + 1] = visibleLOD3;
}