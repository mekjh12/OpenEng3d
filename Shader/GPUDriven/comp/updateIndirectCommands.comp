#version 450 core

layout(local_size_x = 1) in;

// ===== SSBO Bindings =====

// Indirect Command Buffer (통합)
layout(std430, binding = 10) writeonly buffer IndirectCommands {
    // DrawArraysIndirectCommand: 4 uints per command
    // [cmdIdx * 4 + 0] = vertexCount    (읽기 전용, 초기화 시 설정됨)
    // [cmdIdx * 4 + 1] = instanceCount  ← 여기만 업데이트!
    // [cmdIdx * 4 + 2] = first
    // [cmdIdx * 4 + 3] = baseInstance
    uint indirectCommands[];
};

// Visible Counts (배치별)
layout(std430, binding = 11) readonly buffer VisibleCounts_LOD0 {
    uint visibleCounts_LOD0[];  // [batchID]
};

layout(std430, binding = 12) readonly buffer VisibleCounts_LOD1 {
    uint visibleCounts_LOD1[];  // [batchID]
};

// ===== Uniforms =====
uniform uint numBatches;
uniform uint batchCommandStartIndices[64];  // 각 배치의 시작 command 인덱스
uniform uint numModelsPerBatch[64];         // 배치별 모델 개수

void main() {
    uint batchID = gl_GlobalInvocationID.x;
    if (batchID >= numBatches) return;
    
    uint cmdStartIdx = batchCommandStartIndices[batchID];
    uint numModels = numModelsPerBatch[batchID];
    
    // ===== LOD0: 모든 모델에 같은 instanceCount 적용 =====
    // (같은 배치 내 모든 모델은 같은 culling 결과 공유)
    uint visibleLOD0 = visibleCounts_LOD0[batchID];
    
    for (uint m = 0; m < numModels; m++) {
        uint cmdIdx = cmdStartIdx + m;
        // instanceCount 필드만 업데이트 (offset = 1)
        indirectCommands[cmdIdx * 4 + 1] = visibleLOD0;
    }
    
    // ===== LOD1: Impostor command =====
    uint impostorCmdIdx = cmdStartIdx + numModels;
    uint visibleLOD1 = visibleCounts_LOD1[batchID];
    indirectCommands[impostorCmdIdx * 4 + 1] = visibleLOD1;
}