#version 450 core
layout(local_size_x = 1) in;

// Visible Counts (배치별)
layout(std430, binding = 6) readonly buffer VisibleCounts_LOD0 {uint visibleCounts_LOD0[];};
layout(std430, binding = 8) readonly buffer VisibleCounts_LOD1 {uint visibleCounts_LOD1[];};
layout(std430, binding = 10) readonly buffer VisibleCounts_LOD2 {uint visibleCounts_LOD2[];};
layout(std430, binding = 12) readonly buffer VisibleCounts_LOD3 {uint visibleCounts_LOD3[];};

// Indirect Command Buffer (바이트 단위 접근)
layout(std430, binding = 13) writeonly buffer IndirectCommands {uint indirectCommands[];};

uniform uint numBatches;
uniform uint batchCommandStartIndices[64];  // 바이트 오프셋 (0, 68, 136...)

void main() {
    uint batchID = gl_GlobalInvocationID.x;
    if (batchID >= numBatches) return;
    
    // 바이트 오프셋을 uint 인덱스로 변환 (4바이트 = 1 uint)
    uint byteOffset = batchCommandStartIndices[batchID];
    uint baseIndex = byteOffset / 4;
    
    uint visibleLOD0 = visibleCounts_LOD0[batchID];
    uint visibleLOD1 = visibleCounts_LOD1[batchID];
    uint visibleLOD2 = visibleCounts_LOD2[batchID];
    uint visibleLOD3 = visibleCounts_LOD3[batchID];
    
    // LOD0: 바이트 오프셋 + 0, 16바이트 (4 uints)
    // instanceCount는 두 번째 uint
    indirectCommands[baseIndex + 1] = visibleLOD0;
    
    // LOD1: 바이트 오프셋 + 16, 20바이트 (5 uints)
    // 16 bytes = 4 uints, instanceCount는 두 번째 uint
    indirectCommands[baseIndex + 4 + 1] = visibleLOD1;
    
    // LOD2: 바이트 오프셋 + 36, 16바이트 (4 uints)
    // 36 bytes = 9 uints
    indirectCommands[baseIndex + 9 + 1] = visibleLOD2;
    
    // LOD3: 바이트 오프셋 + 52, 16바이트 (4 uints)
    // 52 bytes = 13 uints
    indirectCommands[baseIndex + 13 + 1] = visibleLOD3;
}