#version 430 core

// ============================================================================
// River Mask Generation - Pass 1: Initial Filter
// ============================================================================
// 목적: 물이 흐르는 영역을 추출하여 riverMask 생성
// 입력: waterBuffer (물 깊이, 흐름 방향, 흐름 강도)
// 출력: riverMask (0.0 또는 1.0)
// ============================================================================

layout(local_size_x = 16, local_size_y = 16) in;

// ============================================================================
// 텍스처 바인딩
// ============================================================================
layout(rgba32f, binding = 0) readonly uniform image2D waterBuffer;    // 입력: 물 시뮬레이션 결과
layout(rgba32f, binding = 1) writeonly uniform image2D riverMask;        // 출력: 강 마스크

// ============================================================================
// 유니폼 파라미터
// ============================================================================
uniform float minWaterDepth = 0.05;     // 최소 물 깊이 (이보다 얕으면 무시)
uniform float minFluxMagnitude = 0.01;  // 최소 흐름 강도 (고인 물 판별)
uniform float deepWaterDepth = 0.2;     // 깊은 물 기준 (흐르지 않아도 포함)

void main() 
{
    // ------------------------------------------------------------------------
    // 좌표 초기화 및 경계 검사
    // ------------------------------------------------------------------------
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(riverMask);
    
    if (coords.x >= size.x || coords.y >= size.y) return;

    // ------------------------------------------------------------------------
    // waterBuffer에서 데이터 읽기
    // ------------------------------------------------------------------------
    // waterBuffer 구조:
    // r: 물의 양 (깊이)
    // g: 흐름 방향 X (0~1, 0.5 = 중립)
    // b: 흐름 방향 Y (0~1, 0.5 = 중립)
    // a: 흐름 강도 (magnitude)
    vec4 waterData = imageLoad(waterBuffer, coords);
    
    float waterDepth = waterData.r;        // 물 깊이
    float fluxMagnitude = waterData.a;     // 흐름 강도

    // ------------------------------------------------------------------------
    // Pass 1: 강 영역 판별 로직
    // ------------------------------------------------------------------------
    // 다음 중 하나라도 만족하면 "강"으로 분류:
    // 
    // 조건 1: 물이 충분히 깊다 (깊은 호수, 연못 등)
    //         → waterDepth > deepWaterDepth
    // 
    // 조건 2: 물이 있고 흐름이 있다 (개울, 강 등)
    //         → waterDepth > minWaterDepth AND fluxMagnitude > minFluxMagnitude
    // 
    // 이렇게 하면:
    // - 작은 개울도 포함 (낮은 threshold)
    // - 고인 깊은 물도 포함 (호수)
    // - 극소 웅덩이는 제외 (노이즈)
    // ------------------------------------------------------------------------
    
    float isRiver = 0.0;  // 기본값: 강이 아님
    
    // 조건 1: 깊은 물 (흐르지 않아도 포함)
    if (waterDepth > deepWaterDepth) {
        isRiver = 1.0;
    }
    // 조건 2: 얕지만 흐르는 물
    else if (waterDepth > minWaterDepth && fluxMagnitude > minFluxMagnitude) {
        isRiver = 1.0;
    }

    // ------------------------------------------------------------------------
    // 결과 저장
    // ------------------------------------------------------------------------
    imageStore(riverMask, coords, vec4(isRiver, isRiver, isRiver, 1.0));
}
